# Database (SQLite by default — zero config for local dev/demo).
# For production, point this at a PostgreSQL connection string and change
# `provider` in prisma/schema.prisma to "postgresql" (see the comment at the
# top of that file for what else that unlocks, e.g. pgvector embeddings).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# AI provider abstraction (src/lib/ai/provider.ts). Currently supported: anthropic
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
